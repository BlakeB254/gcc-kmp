{
  "name": "gcc-site",
  "version": "0.1.0",
  "description": "Global Community Cleaners - Uber-like platform for paid block cleaning",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7350",
    "build": "next build",
    "start": "next start -p 7350",
    "lint": "next lint",
    "seed": "tsx src/seed/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:mobile": "playwright test --config=e2e/playwright.config.ts --project='Mobile Chrome'",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "remotion:preview": "remotion preview remotion/index.ts",
    "remotion:render:portrait": "remotion render remotion/index.ts GCCAd-Portrait out/gcc-ad-portrait.mp4",
    "remotion:render:landscape": "remotion render remotion/index.ts GCCAd-Landscape out/gcc-ad-landscape.mp4",
    "remotion:render:square": "remotion render remotion/index.ts GCCAd-Square out/gcc-ad-square.mp4",
    "remotion:render:all": "npm run remotion:render:portrait && npm run remotion:render:landscape && npm run remotion:render:square"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@remotion/bundler": "^4.0.407",
    "@remotion/cli": "^4.0.407",
    "@remotion/google-fonts": "^4.0.407",
    "@turf/area": "^7.3.5",
    "@turf/buffer": "^7.3.5",
    "@turf/difference": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/intersect": "^7.3.5",
    "@turf/union": "^7.3.5",
    "@types/leaflet": "^1.9.21",
    "@types/pg": "^8.16.0",
    "@vercel/blob": "^2.3.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^4.7.1",
    "next": "^16.2.0-canary.1",
    "pg": "^8.17.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-map-gl": "^7.1.9",
    "remotion": "^4.0.407",
    "resend": "^6.8.0",
    "sharp": "^0.33.5",
    "stripe": "^20.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.4.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
