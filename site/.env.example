# ===== Required =====

# Neon PostgreSQL connection string (shared with Ktor server)
DATABASE_URI=postgresql://user:password@localhost:5432/gcc

# JWT Authentication
# REQUIRED: Generate a secure random string (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-min-32-chars

# Stripe keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend email service (https://resend.com/api-keys)
RESEND_API_KEY=re_...
EMAIL_FROM=GCC <noreply@globalcommunitycleaners.org>
EMAIL_REPLY_TO=hello@globalcommunitycleaners.org

# Vercel Blob storage (image uploads)
BLOB_READ_WRITE_TOKEN=...

# App URL (set to production domain for email links)
NEXT_PUBLIC_APP_URL=http://localhost:7300

# ===== Optional =====

# CDX Tile Server (for vector tile layers)
# Leave blank to use default localhost:7400
NEXT_PUBLIC_TILE_SERVER_URL=

# Twilio SMS notifications
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Web Push notifications (VAPID) — browser/PWA only, NOT native iOS
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# Native iOS push (APNs, token-based auth) — required to deliver route-offer
# push to the iOS app. Create an APNs Auth Key in App Store Connect → Keys.
APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_KEY_ID=...            # 10-char Key ID
APNS_TEAM_ID=...           # 10-char Apple Team ID
APNS_BUNDLE_ID=com.globalcommunitycleaners.worker
APNS_ENV=sandbox           # "sandbox" (dev builds) or "production"

# Route-release cron (Vercel Cron → GET /api/cron/route-releases).
# Vercel injects this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=...

# Android closed test (/android-beta). Optional. Set to the link of a
# self-join Google Group that is attached to the closed-test track in Play
# Console, and signups get the join links at once instead of waiting for an
# admin. Must be an https://groups.google.com/... link or it is ignored.
# Server-only on purpose: it is read per request, so changing it needs no rebuild.
# ANDROID_TESTER_GROUP_URL=https://groups.google.com/g/gcc-android-testers

# Ktor API URL (for Phase 4b migration — site calling Ktor directly)
# NEXT_PUBLIC_KTOR_API_URL=http://localhost:7310
