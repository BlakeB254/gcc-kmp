# Copy to .env and fill in. Never commit the filled-in .env.
# Neon Postgres (same DB the Next.js app uses). Include ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Cloudflare R2 (same values as the Next.js app's Vercel env)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gcc-scan-storage

# Bearer token guarding POST /admin/index-scans (generate a random string)
INDEX_SECRET=

# Background sweep cadence in minutes (0 disables the scheduler)
INDEX_INTERVAL_MINUTES=30

# Only if you enable the cloudflared sidecar:
# CLOUDFLARE_TUNNEL_TOKEN=
