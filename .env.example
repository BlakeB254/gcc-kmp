# GCC Ktor Server Environment Variables
# Copy this to .env and fill in your values

# REQUIRED: Neon PostgreSQL connection string
# Get this from console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: Server port (default: 7310)
PORT=7310

# Optional: JWT configuration (defaults shown)
JWT_SECRET=dev-secret-change-in-production
JWT_ISSUER=gcc-api
JWT_AUDIENCE=gcc-app

# Optional: CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:7310
