# GCC Worker App - ProGuard Rules

# Ktor client
-keep class io.ktor.** { *; }
-dontwarn io.ktor.**

# Kotlinx serialization
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.AnnotationsKt
-keepclassmembers class kotlinx.serialization.json.** { *** Companion; }
-keepclasseswithmembers class kotlinx.serialization.json.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class com.gcc.shared.model.**$$serializer { *; }
-keepclassmembers class com.gcc.shared.model.** {
    *** Companion;
}
-keepclasseswithmembers class com.gcc.shared.model.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# Decompose
-keep class com.arkivanov.decompose.** { *; }

# Koin
-keep class org.koin.** { *; }

# logback-android (SLF4J → logcat). Loaded reflectively from assets/logback.xml;
# R8 must keep the appender/encoder classes the XML names.
-keep class ch.qos.logback.** { *; }
-keep class org.slf4j.** { *; }
-dontwarn ch.qos.logback.**
-dontwarn org.slf4j.**

# kotlinx-datetime is pinned at 0.6.1 (libs.versions.toml: 0.7 removes Instant and
# breaks 20+ serialized models). keight 0.0.04 — pulled in by compottie-resources
# 2.0.2 for Lottie expressions — was compiled against 0.7, where Month/DayOfWeek are
# real classes rather than JVM typealiases. Debug builds already run with this
# mismatch; R8 is only the first tool to notice. These paths run only for Lottie
# expressions that call JS Date functions. Generated by AGP: missing_rules.txt.
-dontwarn kotlinx.datetime.DayOfWeek
-dontwarn kotlinx.datetime.Month
-dontwarn kotlinx.datetime.OverloadMarker
