default_platform(:ios)

platform :ios do
  desc "Create Apple Distribution certificate if needed"
  lane :create_cert do
    get_certificates(
      development: false,
      force: false,
    )
    get_provisioning_profile(
      development: false,
      app_identifier: "com.globalcommunitycleaners.worker",
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    # Ensure distribution cert + profile exist
    get_certificates(development: false, force: false, api_key: api_key)
    profile = get_provisioning_profile(
      development: false,
      app_identifier: "com.globalcommunitycleaners.worker",
      api_key: api_key,
    )

    # Build the Kotlin framework first (release config for device)
    sh("cd ../.. && ./gradlew :composeApp:compileKotlinIosArm64 --rerun-tasks")

    # Archive — leave automatic signing in place (the project's
    # CODE_SIGN_STYLE = Automatic). The earlier errSecInternalComponent
    # was a keychain partition-list issue, not a wrong-cert issue;
    # unlocking the keychain + opening the partition list (apple-tool,
    # apple, codesign) above is what actually unblocks codesign.
    build_app(
      project: "iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      output_directory: "/tmp/gcc-build",
      output_name: "GCC.ipa",
      clean: true,
      # Explicitly point codesign at the unlocked login keychain — when
      # xcodebuild runs over SSH the default search-list resolution can
      # miss the GUI-user's keychain and codesign returns
      # errSecInternalComponent on embedded frameworks.
      xcargs: 'OTHER_CODE_SIGN_FLAGS="--keychain $HOME/Library/Keychains/login.keychain-db"',
      export_options: {
        provisioningProfiles: {
          "com.globalcommunitycleaners.worker" => profile["provisioningProfile"]
        }
      }
    )

    # Upload to App Store Connect (internal TestFlight available immediately)
    upload_to_testflight(
      api_key: api_key,
      ipa: "/tmp/gcc-build/GCC.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Distribute an existing build to TestFlight groups"
  lane :distribute do |options|
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    build = options[:build] || "81"

    upload_to_testflight(
      api_key: api_key,
      # distribute_only: true tells pilot to distribute an EXISTING build
      # in App Store Connect rather than try to upload a fresh IPA.
      distribute_only: true,
      skip_submission: false,
      distribute_external: true,
      groups: ["Beta Testers"],
      app_version: "1.0.5",
      build_number: build,
      changelog: File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)),
      notify_external_testers: true,
    )
  end

  desc "Submit latest build to App Store Review"
  lane :submit do
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    deliver(
      api_key: api_key,
      app_version: "1.0.5",
      build_number: "81",
      submit_for_review: true,
      automatic_release: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      overwrite_screenshots: false,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "en-US" => File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)),
      },
      submission_information: {
        add_id_info_uses_idfa: false,
      },
    )
  end

  desc "Push screenshots + metadata only (no binary, no review submit)"
  lane :screenshots do
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )
    deliver(
      api_key: api_key,
      app_version: "1.0.5",
      submit_for_review: false,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "en-US" => File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)),
      },
    )
  end
end
