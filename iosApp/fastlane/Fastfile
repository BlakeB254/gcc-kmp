require "xcodeproj"
require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Create Apple Distribution certificate if needed"
  lane :create_cert do
    get_certificates(
      development: false,
      force: false,
    )
    get_provisioning_profile(
      development: false,
      app_identifier: "com.globalcommunitycleaners.worker",
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    # Headless signing (2026-07-11): SSH sessions can't use the locked login
    # keychain (codesign dies with errSecInternalComponent), which blocked
    # DGX-triggered TestFlight builds. A dedicated build keychain whose
    # password lives at ~/.config/gcc/build-keychain-pass (0600, generated
    # once) lets this lane unlock signing itself in ANY session — GUI or SSH.
    keychain_password_file = File.expand_path("~/.config/gcc/build-keychain-pass")
    if File.exist?(keychain_password_file)
      keychain_password = File.read(keychain_password_file).strip
      # fastlane's create_keychain names the file "gcc-build-db" (no
      # ".keychain" infix) on modern macOS; accept either spelling.
      keychain_candidates = [
        File.expand_path("~/Library/Keychains/gcc-build-db"),
        File.expand_path("~/Library/Keychains/gcc-build.keychain-db"),
      ]
      keychain_db = keychain_candidates.find { |f| File.exist?(f) }
      unless keychain_db
        create_keychain(
          name: "gcc-build",
          password: keychain_password,
          default_keychain: false,
          unlock: true,
          timeout: 0,          # never auto-lock — this keychain holds ONLY the build cert
          add_to_search_list: true,
        )
        keychain_db = keychain_candidates.find { |f| File.exist?(f) }
      end
      unlock_keychain(path: "gcc-build", password: keychain_password)
      # Open the keys' partition list so codesign can use them without a UI
      # prompt (otherwise headless runs die with errSecInternalComponent even
      # on an unlocked keychain). NOTE: after a FRESH key import this stamp
      # itself needs one GUI-session run — SSH sessions get "User interaction
      # is not allowed" and the stamp is silently a no-op. Harmless when
      # already stamped, hence unconditional with a soft failure.
      if keychain_db
        sh("security set-key-partition-list -S apple-tool:,apple: -s -k #{keychain_password.shellescape} #{keychain_db.shellescape} >/dev/null 2>&1 || true")
      end
      ENV["GCC_BUILD_KEYCHAIN"] = keychain_db
      ENV["GCC_BUILD_KEYCHAIN_PASSWORD"] = keychain_password
    end

    # Ensure distribution cert + profile exist. Set FORCE_PROFILE_RENEWAL=1
    # after capability changes so Apple regenerates the entitlement payload.
    if ENV["GCC_BUILD_KEYCHAIN"]
      get_certificates(
        development: false, force: false, api_key: api_key,
        keychain_path: ENV["GCC_BUILD_KEYCHAIN"],
        keychain_password: ENV["GCC_BUILD_KEYCHAIN_PASSWORD"],
      )
    else
      get_certificates(development: false, force: false, api_key: api_key)
    end
    get_provisioning_profile(
      development: false,
      force: ENV["FORCE_PROFILE_RENEWAL"] == "1",
      app_identifier: "com.globalcommunitycleaners.worker",
      api_key: api_key,
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    xcodeproj_path = File.expand_path("../iosApp.xcodeproj", __dir__)
    project = Xcodeproj::Project.open(xcodeproj_path)
    target = project.targets.find { |item| item.name == "iosApp" }
    release_config = target.build_configurations.find { |item| item.name == "Release" }
    release_config.build_settings["CODE_SIGN_STYLE"] = "Manual"
    release_config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution: Blake Bullard (7BBNW25LZM)"
    release_config.build_settings["PROVISIONING_PROFILE"] = profile_uuid
    release_config.build_settings.delete("PROVISIONING_PROFILE_SPECIFIER")
    project.save

    # Build the Kotlin framework and package-shaped Compose resources first.
    # The archive script copies these prebuilt outputs into Xcode's app bundle
    # so the archive step does not have to link Kotlin/Native again.
    sh("cd ../.. && ./gradlew :composeApp:linkReleaseFrameworkIosArm64 :composeApp:iosArm64AggregateResources --console=plain -Pgcc.disableNativeReleaseOptimization=true -Pkotlin.native.isAllowRunningInProcess=false -Dorg.gradle.jvmargs='-Xmx3072m -XX:+UseSerialGC -Dfile.encoding=UTF-8'")

    signing_args = [
      "DEVELOPMENT_TEAM=7BBNW25LZM",
    ].join(" ")

    # Archive with distribution signing while leaving dependency targets on
    # automatic signing; export then applies the regenerated App Store profile.
    build_app(
      project: "iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      output_directory: "/tmp/gcc-build",
      output_name: "GCC.ipa",
      clean: true,
      skip_package_dependencies_resolution: true,
      package_authorization_provider: "netrc",
      xcargs: signing_args,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "7BBNW25LZM",
        manageAppVersionAndBuildNumber: false,
        provisioningProfiles: {
          "com.globalcommunitycleaners.worker" => profile_name
        }
      }
    )

    # Compose Multiplatform resources are loaded at app startup by the splash,
    # logo, and font code. Fail the release before upload if Xcode packaging
    # ever drops them from the final IPA.
    sh("unzip -l /tmp/gcc-build/GCC.ipa | grep -q 'Payload/Global Community Cleaners.app/compose-resources/composeResources/gcc_kmp.composeapp.generated.resources/files/spinning_globe.json'")
    sh("unzip -l /tmp/gcc-build/GCC.ipa | grep -q 'Payload/Global Community Cleaners.app/compose-resources/composeResources/gcc_kmp.composeapp.generated.resources/drawable/gcc_logo.png'")

    # Upload to App Store Connect (internal TestFlight available immediately)
    upload_to_testflight(
      api_key: api_key,
      ipa: "/tmp/gcc-build/GCC.ipa",
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Distribute an existing build to TestFlight groups"
  lane :distribute do |options|
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    # REQUIRED, never defaulted. This lane distributes to EXTERNAL testers,
    # and a default would happily ship a months-old binary to them.
    build = options[:build]
    UI.user_error!("Pass the build to distribute, e.g. fastlane distribute build:143") if build.to_s.strip.empty?
    review_contact_phone = ENV["APP_REVIEW_CONTACT_PHONE"]
    UI.user_error!("Set APP_REVIEW_CONTACT_PHONE before external TestFlight distribution") if review_contact_phone.to_s.strip.empty?
    metadata_dir = File.expand_path("metadata/en-US", __dir__)

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.globalcommunitycleaners.worker",
      app_platform: "ios",
      beta_app_review_info: {
        contact_email: "blakeb254@icloud.com",
        contact_first_name: "Blake",
        contact_last_name: "Bullard",
        contact_phone: review_contact_phone,
        demo_account_name: File.read(File.join(metadata_dir, "review_information/demo_user.txt")).strip,
        demo_account_password: File.read(File.join(metadata_dir, "review_information/demo_password.txt")).strip,
        demo_account_required: true,
        notes: File.read(File.join(metadata_dir, "review_information/notes.txt")),
      },
      localized_app_info: {
        "default": {
          feedback_email: "blakeb254@icloud.com",
          marketing_url: "https://globalcommunitycleaners.org",
          privacy_policy_url: File.read(File.join(metadata_dir, "privacy_url.txt")).strip,
          description: "Global Community Cleaners helps approved GCC workers report trash spots, accept cleaning routes, document before-and-after evidence, and support funded cleanup bounties. This beta is for real-device testing of sign-in, spot reporting, bounty-to-spot flows, map heatmap visuals, camera capture, and GPS-verified cleanup documentation.",
        },
      },
      # distribute_only: true tells pilot to distribute an EXISTING build
      # in App Store Connect rather than try to upload a fresh IPA.
      distribute_only: true,
      skip_submission: false,
      distribute_external: true,
      groups: ["Beta Testers"],
      app_version: "1.0.7",
      build_number: build,
      changelog: File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)),
      notify_external_testers: true,
    )
  end

  desc "Submit a build to App Store Review: bundle exec fastlane submit build:<n> [version:<x.y.z>]"
  lane :submit do |options|
    # `build` is REQUIRED, never defaulted: this lane once hardcoded
    # build_number "89" alongside automatic_release, so an unguarded run would
    # have submitted a months-old binary and shipped it to the public.
    app_version = options[:version] || "1.0.7"

    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    build = options[:build]
    UI.user_error!("Pass the build to submit, e.g. fastlane submit build:139") if build.to_s.strip.empty?

    # automatic_release defaults to false: an approved version waits in
    # Pending Developer Release until someone presses the button.
    deliver(
      api_key: api_key,
      app_version: app_version.to_s,
      build_number: build.to_s,
      submit_for_review: true,
      automatic_release: options.fetch(:automatic_release, false),
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      overwrite_screenshots: false,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "en-US" => File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)),
      },
      submission_information: {
        add_id_info_uses_idfa: false,
      },
    )
  end

  desc "Push screenshots + metadata only (no binary, no review submit)"
  lane :screenshots do
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )
    deliver(
      api_key: api_key,
      app_version: "1.0.7",
      submit_for_review: false,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      release_notes: {
        "en-US" => File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)),
      },
    )
  end
end
