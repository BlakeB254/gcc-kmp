default_platform(:ios)

platform :ios do
  desc "Create Apple Distribution certificate if needed"
  lane :create_cert do
    get_certificates(
      development: false,
      force: false,
    )
    get_provisioning_profile(
      development: false,
      app_identifier: "com.globalcommunitycleaners.worker",
    )
  end

  desc "Build and upload to App Store Connect"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    # Ensure distribution cert + profile exist
    get_certificates(development: false, force: false, api_key: api_key)
    profile = get_provisioning_profile(
      development: false,
      app_identifier: "com.globalcommunitycleaners.worker",
      api_key: api_key,
    )

    # Build the Kotlin framework first (release config for device)
    sh("cd ../.. && ./gradlew :composeApp:compileKotlinIosArm64 --rerun-tasks")

    # Archive
    build_app(
      project: "iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      output_directory: "/tmp/gcc-build",
      output_name: "GCC.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.globalcommunitycleaners.worker" => profile["provisioningProfile"]
        }
      }
    )

    # Upload to App Store Connect and distribute to TestFlight testers
    upload_to_testflight(
      api_key: api_key,
      ipa: "/tmp/gcc-build/GCC.ipa",
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      groups: ["Beta Testers"],
      changelog: File.read("fastlane/metadata/en-US/release_notes.txt"),
      notify_external_testers: true,
    )
  end

  desc "Distribute an existing build to TestFlight groups"
  lane :distribute do |options|
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    build = options[:build] || "74"

    upload_to_testflight(
      api_key: api_key,
      skip_submission: false,
      distribute_external: true,
      groups: ["Beta Testers"],
      app_version: "1.0.3",
      build_number: build,
      changelog: File.read("fastlane/metadata/en-US/release_notes.txt"),
      notify_external_testers: true,
    )
  end

  desc "Submit latest build to App Store Review"
  lane :submit do
    api_key = app_store_connect_api_key(
      key_id: "XKAYZ4N88V",
      issuer_id: "f40473c6-81af-4172-87a6-01bc0974972e",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XKAYZ4N88V.p8"),
      in_house: false,
    )

    deliver(
      api_key: api_key,
      app_version: "1.0.3",
      build_number: "75",
      submit_for_review: true,
      automatic_release: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true,
      release_notes: {
        "en-US" => File.read("fastlane/metadata/en-US/release_notes.txt"),
      },
      submission_information: {
        add_id_info_uses_idfa: false,
      },
    )
  end
end
