[Unit]
Description=GCC cron: verification-docs retention, DRY until Blake confirms enforce (90 days)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/home/codexian/.config/cdx/gcc-cron.env
# Dry-run: logs what a 90-day purge would delete. To enforce, change retention=dry to retention=enforce.
ExecStart=/usr/bin/curl -fsS -m 90 -H "Authorization: Bearer ${CRON_SECRET}" "https://api.globalcommunitycleaners.org/api/cron/verification-docs?retention_days=90&retention=dry"
