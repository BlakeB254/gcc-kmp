[Unit]
Description=GCC cron: scan-index (R2 capture sessions -> scan_sessions/capture_chunks, enqueue reconstruction_jobs)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/home/codexian/.config/cdx/gcc-cron.env
ExecStart=/usr/bin/curl -fsS -m 90 -H "Authorization: Bearer ${CRON_SECRET}" https://api.globalcommunitycleaners.org/api/cron/scan-index
